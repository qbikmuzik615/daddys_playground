{
  "buildCommand": "cd apps/quiztastic-opposites && npm install && npm run build",
  "outputDirectory": "apps/quiztastic-opposites/dist",
  "installCommand": "echo 'Using build command for installation'",
  "framework": null,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
